# Never commit real secrets.

# Cloudflare deployment
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# AI providers, all optional because fallback is required
PIPELINE_AI_ENABLED=false
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Generic OpenAI-compatible provider supplied by the owner
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Pipeline
PIPELINE_TIMEZONE=Asia/Dhaka
PIPELINE_MAX_LLM_STORIES_PER_RUN=50
PIPELINE_LOG_LEVEL=INFO
PIPELINE_USER_AGENT=

# Optional public analytics configuration
PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Public credential-free HTTPS origin, without a path/query/fragment.
# Required for production canonical URLs/RSS/sitemap.
SITE_URL=
# Explicit staging isolation; production verification refuses a noindex build.
SITE_NOINDEX=true

# Future hosted smoke test only; never set an invented public origin.
SMOKE_BASE_URL=
SMOKE_EXPECT_INDEXING=false
