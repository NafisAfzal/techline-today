---
import { localeFor, t, localizedPath, storyCount } from '../lib/i18n';
import type { Story } from '../../../../packages/contracts';
import { data } from '../lib/data';
import StoryCard from './StoryCard.astro';
interface Props { stories: Story[]; saved?: boolean }
const {stories, saved = false} = Astro.props;
const initialCount = 24;
const locale = localeFor(Astro.url.pathname);
const ui = (key: string) => t(locale, key);
const href = (path: string) => localizedPath(path, locale);
---
<section class="feed-section" data-feed data-saved={String(saved)} data-reference={data.generated_at} aria-label={ui(saved ? 'Saved stories' : 'Story feed')}>
  {!saved && <div class="feed-toolbar"><div class="periods" aria-label={ui("Time period")}>{[['latest','All dates'],['today','Today'],['week','This week'],['month','This month'],['year','This year']].map(([value,label]) => <button type="button" data-period={value} aria-pressed={value === 'latest' ? 'true':'false'}>{ui(label)}</button>)}</div><label class="sort-label">{ui("Sort")}<select data-sort aria-label={ui("Sort stories")}><option value="importance">{ui("Importance")}</option><option value="latest">{ui("Newest first")}</option></select></label></div>}
  <div class="feed-heading"><h2>{ui(saved ? 'Your reading list' : 'Stories in this edition')}</h2><span class="mono" data-result-count aria-live="polite" aria-atomic="true">{storyCount(Math.min(initialCount,stories.length),locale)}</span></div>
  <div class="story-grid">{stories.slice(0, initialCount).map(story => <StoryCard story={story} />)}</div>
  {stories.length > initialCount && <><template data-feed-remainder>{stories.slice(initialCount).map(story => <StoryCard story={story} />)}</template><button type="button" data-feed-more>{ui("Show more stories")}</button><noscript><p class="small">{ui("Read all stories in the")} <a href={href("/digests/")}>{ui("complete period editions")}</a>.</p></noscript></>}
  <div class="empty-state" data-empty hidden={stories.length > 0}><span class="eyebrow">{ui("A little quiet here")}</span><h3>{ui(saved ? 'Make room for a good read.' : 'No stories in this view yet.')}</h3><p>{ui(saved ? 'Use Save on any story. Your reading list stays on this device.' : 'Try another time period or return after the next collection.')}</p><a href={href("/")}>{ui("Browse the briefing →")}</a></div>
  <p class="small">{ui("This view shows up to 120 selected stories.")}<a href={href("/digests/")}>{ui("Browse complete period editions")}</a> {ui("or")} <a href={href("/archives/")}>{ui("older archives")}</a>.</p><p role="status" data-storage-status class="storage-status"></p>
</section>
