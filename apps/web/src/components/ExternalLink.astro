---
interface Props { href: string; class?: string; label?: string }
const {href, class: className, label} = Astro.props;
const safe = new URL(href).protocol === 'https:';
if (!safe) throw new Error('Unsafe external URL');
---
<a href={href} target="_blank" rel="noopener noreferrer" class={className} aria-label={label}><slot /><span aria-hidden="true"> ↗</span></a>
