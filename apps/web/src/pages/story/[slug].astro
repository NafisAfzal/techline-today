---
import { localeFor, t, localizedPath, localizedStory, contentLanguage } from '../../lib/i18n';
import Layout from '../../layouts/Layout.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import Headline from '../../components/Headline.astro';
import SourceLicense from '../../components/SourceLicense.astro';
import ContentIndicators from '../../components/ContentIndicators.astro';
import { preprint, showSignificance, trustExplanation } from '../../lib/trust';
import { preprintNotice, limitationsUnknown } from '../../../../../scripts/coverage.mjs';
import { readingSummary, previewLine } from '../../lib/editorial';
import { data, date, evidenceLabels, original } from '../../lib/data';
export function getStaticPaths() { return data.stories.map(story => ({params:{slug:story.slug},props:{story}})); }
const {story: canonicalStory} = Astro.props;
const source = original(canonicalStory);
const sources = canonicalStory.source_ids.map(id => data.sources[id]!);
const locale = localeFor(Astro.url.pathname);
const ui = (key: string) => t(locale, key);
const href = (path: string) => localizedPath(path, locale);
const story = localizedStory(canonicalStory,locale);
const lang = contentLanguage(canonicalStory,locale);
const preprintStory = preprint(canonicalStory, data.sources);
const policyLimitations = preprintStory ? [preprintNotice, limitationsUnknown] : [];
---
<Layout title={story.headline} description={story.summary_bullets.join(' ')}>
  <article data-pagefind-body data-search-description={previewLine(story)} data-search-language={lang} data-pagefind-meta="description[data-search-description], language[data-search-language]"><header class="detail-heading"><nav aria-label={ui("Breadcrumb")} class="breadcrumb"><a href={href("/")}>{ui("The briefing")}</a> / <a href={href(`/category/${story.category}/`)}>{ui(data.categories[story.category].label)}</a></nav><div class="story-meta" data-pagefind-ignore><span class="category-tag" data-pagefind-filter="category">{ui(data.categories[story.category].label)}</span><a href={href("/about/#evidence")} title={ui(trustExplanation(canonicalStory, data.sources))} class={`evidence ${story.evidence_state}`}>{ui(evidenceLabels[story.evidence_state])}</a><ContentIndicators story={canonicalStory}/><span class="small">{story.ai_metadata.generation_mode === 'extractive' ? ui('Extractive summary') : ui('AI-assisted summary')}</span></div><h1 lang={lang} data-pagefind-meta="title"><Headline text={story.headline}/></h1></header>
  <p class="small" data-trust-explanation>{ui(trustExplanation(canonicalStory, data.sources))}</p>
  <div class="detail-actions" data-pagefind-ignore><ExternalLink href={source.original_url} label={ui("Read the original source")}>{ui("Original source")}</ExternalLink><button type="button" data-bookmark={story.id} aria-pressed="false" data-story-title={story.headline} aria-label={`${ui("Save story")}: ${story.headline}`}>{ui("Save")}</button><button type="button" data-read={story.id} aria-pressed="false" aria-label={`${ui("Mark read")}: ${story.headline}`}>{ui("Read")}</button></div><p role="status" data-storage-status class="storage-status"></p>
  {locale === 'bn' && <p class="translation-note">{ui(canonicalStory.translations?.bn ? 'Original evidence stays in its source language.' : 'Bangla unavailable for this story. Showing English.')}</p>}
  <nav class="reading-nav" aria-label={ui("On this page")}><a href="#summary">{ui("Summary")}</a><a href="#key-facts">{ui("Key facts")}</a><a href="#sources">{ui("Sources")}</a><a href="#uncertainty">{ui("Limitations & uncertainty")}</a></nav>
  <div class="detail-layout"><div class="detail-content"><section id="summary"><h2>{ui("Summary")}</h2><ul class="bullets" lang={lang}>{readingSummary(story).map(bullet => <li>{bullet}</li>)}</ul></section><section id="key-facts"><h2>{ui("Key facts")}</h2><ul class="fact-list" lang={lang}>{story.key_facts.map(fact => <li>{fact.text} {fact.source_ids.map(id => <a class="citation" href={`#${id}`} aria-label={`${ui("Evidence from")} ${data.sources[id]!.publisher}`}>[{story.source_ids.indexOf(id)+1}]</a>)}<span class="small"> {ui(fact.attribution === 'primary' ? (preprintStory ? 'Research finding (source-reported)' : 'Source-reported') : fact.attribution)} · {ui(fact.status)}</span></li>)}</ul><div class="chips" lang={lang}>{story.key_numbers.map(number => <span title={number.context}>{number.value} · {number.label}</span>)}</div></section>{showSignificance(canonicalStory) && <section><h2>{ui("Editorial interpretation")}</h2><p lang={lang}>{story.why_it_matters}</p></section>}<section><h2>{ui("What changed")}</h2><details class="change-history"><summary>{ui("View update history")}</summary><ol class="timeline">{story.change_log.map(change => <li><time datetime={change.at}>{date(change.at, true, locale)} BDT</time><p lang="en">{change.text}</p>{change.previous_facts.length > 0 && <details><summary>{ui("Earlier claims, retained for context")}</summary><ul>{change.previous_facts.map(fact => <li lang="en">{fact.text} <span class="small">{ui(fact.status)}</span> {fact.source_ids.map(id => data.sources[id] && <ExternalLink href={data.sources[id]!.original_url}>{data.sources[id]!.publisher}</ExternalLink>)}</li>)}</ul></details>}</li>)}</ol></details></section><section><h2>{ui("Broader context")}</h2><details><summary>{ui("Read beyond the briefing")}</summary><p lang={lang}>{story.broader_summary}</p></details></section><section><h2>{ui("What the sources say")}</h2>{sources.map(item => <p><strong>{item.publisher}</strong> {ui("reports:")} <span lang={item.language}>{item.title}</span> <a class="citation" href={`#${item.id}`}>[{story.source_ids.indexOf(item.id)+1}]</a></p>)}</section><section id="uncertainty" class="limitations"><h2>{ui("Limitations & uncertainty")}</h2>{policyLimitations.map(text => <p>{ui(text)}</p>)}{story.limitations.length ? <ul>{story.limitations.filter(limitation => !policyLimitations.includes(limitation)).map(limitation => <li lang={lang}>{limitation}</li>)}</ul> : <p>{ui("Additional limitations have not been assessed from the collected evidence.")}</p>}</section></div>
  <aside id="sources" class="source-panel" aria-labelledby="sources-title" data-pagefind-ignore><h2 id="sources-title">{ui("Sources")}</h2><ol>{sources.map((item,index) => <li id={item.id}><span class="eyebrow">{String(index+1).padStart(2,'0')} / {ui(item.source_class)}{item.language !== 'en' ? ` · ${item.language}` : ''}</span><strong>{item.publisher}</strong><ExternalLink href={item.original_url}><span lang={item.language}>{item.title}</span></ExternalLink><span class="small" data-source-publication>{item.missing_publication_time ? ui("Publication time unavailable") : <>{ui("Published")} <time datetime={item.published_at}>{date(item.published_at,false,locale)}</time></>}</span><span class="small">{ui("Collected")} {date(item.fetched_at,true,locale)} BDT</span><details><summary class="small">{ui("Limited evidence excerpt")}</summary><blockquote lang={item.language}>{item.excerpt || ui('Only source metadata was available.')}</blockquote></details><SourceLicense registryId={item.source_registry_id}/></li>)}</ol><dl class="timestamps"><dt>{ui("Published")}</dt><dd data-story-publication>{source.missing_publication_time ? ui("Publication time unavailable") : <time datetime={story.published_at}>{date(story.published_at,true,locale)}</time>}</dd><dt>{ui("First seen")}</dt><dd>{date(story.first_seen_at,true,locale)}</dd><dt>{ui("Updated")}</dt><dd>{date(story.updated_at,true,locale)}</dd><dt>{ui("Last verified")}</dt><dd>{date(story.last_verified_at,true,locale)}</dd></dl><p class="small">{ui("All times Asia/Dhaka (BDT).")}<br/>{ui("Source links open in a new tab.")}</p><a href={href("/about/")}>{ui("How evidence labels work →")}</a></aside></div></article>
</Layout>
