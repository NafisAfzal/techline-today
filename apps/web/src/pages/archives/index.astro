---
import { localeFor, t, localizedPath } from '../../lib/i18n';
import Layout from '../../layouts/Layout.astro';
import { data } from '../../lib/data';
const locale = localeFor(Astro.url.pathname);
const ui = (key: string) => t(locale, key);
const href = (path: string) => localizedPath(path, locale);
---
<Layout title={ui("Technology archives")}><section class="page-intro"><p class="eyebrow">{ui("A record that lasts")}</p><h1>{ui("The archive.")}</h1><p>{ui("Individual stories normally stay available for eighteen months. A file budget can compact older records sooner. Monthly bundles preserve evidence and original sources.")}</p></section><nav class="detail-actions" aria-label={ui("Yearly archives")}>{[...new Set(data.archive_index.map(entry => entry.key.slice(0,4)))].map(year => <a href={href(`/archives/year/${year}/`)}>{year} {ui("annual index")} →</a>)}</nav><ul class="digest-list">{data.archive_index.map(entry => <li><a href={href(entry.url)}><h2>{entry.key}</h2><span>{entry.count} {ui("records")} →</span></a></li>)}</ul>{!data.archive_index.length && <div class="empty-state"><h2>{ui("The archive is still young.")}</h2><p>{ui("Monthly bundles appear when older editions are compacted. Recent stories remain in the current edition and digests.")}</p><a class="control-link" href={href("/")}>{ui("Today →")}</a><a class="control-link" href={href("/digests/")}>{ui("Browse digests →")}</a><a class="control-link" href={href("/all/")}>{ui("Browse all stories →")}</a></div>}</Layout>
