---
import { localeFor, t } from '../lib/i18n';
import Layout from '../layouts/Layout.astro';
import { evidenceLabels } from '../lib/data';
const locale = localeFor(Astro.url.pathname);
const ui = (key: string) => t(locale, key);
const explanations: Record<string,string> = {"primary-confirmed": "A primary publisher or original paper is cited. This establishes provenance only; independent corroboration and peer review are separate questions.", "multi-source": "At least two independent editorial groups support the report. Syndicated copies count as one group.", "single-source": "One independent reporting group is available.", "community-report": "A discussion or community claim, used for discovery.", "needs-verification": "Available evidence does not yet meet the other source categories."};
---
<Layout title={ui('Methodology & source policy')}><section class="page-intro"><p class="eyebrow">{ui('A transparent editorial process')}</p><h1>{ui('Context you can trace.')}</h1><p>{ui('Technology news and context, with the evidence close at hand.')}</p></section><div class="prose"><h2>{ui("How an edition is made")}</h2><p>{ui("We collect approved feeds and official APIs periodically. We group reports about the same event and rank them by freshness, source quality and relevance. Popularity alone never makes a claim true.")}</p><p>{ui("Summaries use only collected evidence. Checks catch missing citations and unsupported numbers. Without an AI provider, we quote short parts of the source. Reading the site never starts an AI call.")}</p><h2 id="evidence">{ui('Reading the evidence labels')}</h2><ul>{Object.entries(evidenceLabels).map(([id,label]) => <li><strong>{ui(label)}:</strong> {ui(explanations[id]!)}</li>)}</ul><h2>{ui("Sources & corrections")}</h2><p>{ui("Original links stay visible. We keep short evidence excerpts, not full copies of articles. Vendor claims stay attributed. Conflicting figures appear in limitations, and corrections have a visible history.")}</p><p>{ui("Last verified means the source was checked at that time. It does not mean we repeated its experiments. Stories with only a headline say so.")}</p><h2>{ui("Offers need current terms")}</h2><p>{ui("We show eligibility, billing, regions and expiry when the official terms supply them. Missing terms stay unknown. Expired offers remain in the archive.")}</p><h2>{ui("Your privacy")}</h2><p>{ui("You do not need an account. Saved stories, language, theme and reading preferences stay in your browser. We do not build behavioral profiles. Analytics are off by default.")}</p><h2>{ui("English and Bangla")}</h2><p>{ui("English is canonical. The Bangla interface does not imply translated articles. Production translation is currently unavailable under the source-submission policy. Missing translations show English content with a notice; source evidence retains its original wording.")}</p><h2 id="coverage">{ui("Source coverage")}</h2><p>{ui("Current coverage is limited to arXiv metadata and attributed Cloudflare documentation. Research is not current-news coverage. No additional feeds are active.")}</p><p>{ui("News has a 72-hour publication window, research a 7-day window, and reference material a 30-day window. Collection is overdue after 24 hours. Missing publication dates never establish current news. These are editorial freshness thresholds, not guarantees of accuracy.")}</p><p>{ui("arXiv preprint: peer review has not been established from the collected metadata.")}</p><p>{ui("Paper limitations have not been assessed from the collected abstract.")}</p><p>{ui("This edition's source list is available beside each story. Sources may change or fail; we keep the last validated edition.")}</p><h2>{ui("Limitations")}</h2><p>{ui("Checks catch some structural, numeric and translation errors. They cannot prove every claim or guarantee a perfect translation. Updates are periodic and may be delayed.")}</p></div></Layout>
