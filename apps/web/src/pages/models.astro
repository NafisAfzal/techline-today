---
import { localeFor, t, localizedPath } from '../lib/i18n';
import Layout from '../layouts/Layout.astro';
import { data, date, storyById } from '../lib/data';
import ExternalLink from '../components/ExternalLink.astro';
import TrackerValue from '../components/TrackerValue.astro';
const locale = localeFor(Astro.url.pathname);
const ui = (key: string) => t(locale, key);
const href = (path: string) => localizedPath(path, locale);
---
<Layout title={ui("AI model release tracker")}><section class="page-intro"><h1>{ui("What changed in AI.")}</h1><p>{ui("Model releases with source-reported capabilities. Vendor claims retain their attribution, and independent evaluation stays separate.")}</p></section>{locale === 'bn' && <p class="translation-note">{ui('Tracker details are shown in their verified English wording.')}</p>}<div class="tracker-grid">{data.model_releases.map(release => <article class="tracker-card"><div class="tracker-heading"><p class="eyebrow">{release.provider}</p><h2><span lang="en">{release.model}</span></h2><p class="small">{ui("Release date:")}{' '}<time datetime={release.release_date}>{date(release.release_date,false,locale)}</time></p>{release.key_change !== release.model && <p><span lang="en">{release.key_change}</span></p>}</div><div class="tracker-body"><dl><dt>{ui("Modalities")}</dt><dd><TrackerValue value={release.modality.join(', ')}/></dd><dt>{ui("Context window")}</dt><dd><TrackerValue value={release.context_window}/></dd><dt>{ui("API access")}</dt><dd><TrackerValue value={release.api_available === null ? null : release.api_available ? 'Available; check source constraints' : 'Not offered'}/></dd><dt>{ui("Weights")}</dt><dd><TrackerValue value={release.weights==='unknown'?null:release.weights}/></dd><dt>{ui("Pricing")}</dt><dd><TrackerValue value={release.pricing}/></dd></dl><h3>{ui("Benchmark context")}</h3>{release.benchmark_claims.length ? <ul>{release.benchmark_claims.map(claim => <li>{ui("Vendor-reported:")} <span lang="en">{claim}</span></li>)}</ul> : <p class="small">{ui("No structured benchmark claim has been verified.")}</p>}{release.independent_references.map(url => <ExternalLink href={url}>{ui("Independent benchmark reference")}</ExternalLink>)}<a href={href(`/story/${storyById.get(release.story_id)?.slug}/`)}>{ui("Read the release briefing →")}</a><p class="small">{ui("Checked")}{' '}<time datetime={storyById.get(release.story_id)!.last_verified_at}>{date(storyById.get(release.story_id)!.last_verified_at,true,locale)} BDT</time>{' '}{ui("Missing specifications are not inferred. Consult the briefing’s official sources.")}</p></div></article>)}</div>{!data.model_releases.length && <div class="empty-state"><h2>{ui("No structured releases yet.")}</h2><p>{ui("Release records appear when a primary announcement supplies the evidence.")}</p><a href={href("/category/ai/")}>{ui("Browse AI reports →")}</a></div>}</Layout>
