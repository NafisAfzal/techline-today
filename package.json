{
  "name": "ai-tech-intelligence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @intelligence/web dev",
    "build": "node scripts/third-party-notices.mjs --check && pnpm --filter @intelligence/web build && node scripts/postbuild.mjs && pnpm exec pagefind --site apps/web/dist && node scripts/build-provenance.mjs",
    "notices:generate": "node scripts/third-party-notices.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "pnpm --filter @intelligence/web check",
    "lint": "eslint apps/web/src packages tests scripts --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "uv run python -m pipeline --mode fixture",
    "ingest": "uv run python -m pipeline --mode live",
    "validate": "uv run python -m pipeline --validate",
    "test:python": "uv run pytest",
    "lint:python": "uv run ruff check pipeline",
    "deploy": "node scripts/release-gate.mjs --publish && node scripts/verify-build.mjs --production && node scripts/editorial-quality.mjs --production && pnpm exec wrangler deploy",
    "release:check": "node scripts/release-gate.mjs",
    "quality:content": "node scripts/editorial-quality.mjs",
    "verify:content-rights": "node scripts/content-rights.mjs",
    "inspect:mobile": "node scripts/mobile-review.mjs",
    "deploy:check": "pnpm exec wrangler deploy --dry-run",
    "deploy:preview": "node scripts/release-gate.mjs --publish --preview && node scripts/verify-build.mjs --preview && node scripts/editorial-quality.mjs --production && pnpm exec wrangler deploy --config wrangler.preview.jsonc",
    "security": "node scripts/security.mjs",
    "performance": "node scripts/performance.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "smoke:live": "node scripts/live-smoke.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "verify:repository": "node scripts/verify-repository.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "inspect:ui": "node scripts/inspect-ui.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "eslint": "10.12.0",
    "lighthouse": "13.5.0",
    "pagefind": "1.5.2",
    "parse5": "8.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  }
}
