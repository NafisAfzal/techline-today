{
  "ci": {
    "collect": { "startServerCommand": "node scripts/performance-preview.mjs", "url": ["http://127.0.0.1:4322/"], "numberOfRuns": 3 },
    "assert": { "assertions": { "categories:performance": ["error", {"minScore": 0.95}], "categories:accessibility": ["error", {"minScore": 0.95}], "categories:best-practices": ["error", {"minScore": 0.95}], "largest-contentful-paint": ["error", {"maxNumericValue": 2500}], "cumulative-layout-shift": ["error", {"maxNumericValue": 0.1}] } },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci/reports" }
  }
}
